{
	"name": "pl_fiduplan_extract_db",
	"properties": {
		"description": "Child pipeline: extracts all tables for a single ExpertM database to CSV on ADLS Gen2. Supports incremental via watermark parameter.",
		"activities": [
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.tables",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopyTableToCSV",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "00:30:00",
								"retry": 2,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@if(and(not(empty(pipeline().parameters.watermark)), contains(createArray('tdalgrek','tdjaar','tdboekper','tdklant','tdlev','tddagbfin','tddockla','tddoclev','tdaankoop','tddagbaan','tddagbdiv','tdverkoop','tddagbver','tddivers','tdfinan'), item())), concat('SELECT * FROM [', pipeline().parameters.databaseName, '].dbo.[', item(), '] WHERE [', item(), '_timestamp] >= ''', pipeline().parameters.watermark, ''''), concat('SELECT * FROM [', pipeline().parameters.databaseName, '].dbo.[', item(), ']'))",
										"type": "Expression"
									},
									"queryTimeout": "00:30:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_expertm_sql_table",
									"type": "DatasetReference",
									"parameters": {
										"tableName": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_csv_expertm",
									"type": "DatasetReference",
									"parameters": {
										"folderPath": {
											"value": "@concat('sink_catalog/expertm/', item(), '/year=', formatDateTime(utcNow(), 'yyyy'), '/month=', formatDateTime(utcNow(), 'MM'), '/division=', pipeline().parameters.databaseName)",
											"type": "Expression"
										},
										"fileName": {
											"value": "@concat(item(), '.csv')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"databaseName": {
				"type": "String"
			},
			"tables": {
				"type": "Array"
			},
			"watermark": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-02-10T13:44:33Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}