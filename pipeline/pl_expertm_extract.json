{
	"name": "pl_expertm_extract",
	"properties": {
		"description": "Master pipeline: loops through ExpertM databases and extracts all tables via child pipeline. After extraction, triggers Databricks bronze load.",
		"activities": [
			{
				"name": "FilterExcludedDatabases",
				"description": "Removes known-unavailable databases (not attached to SQL Server) from the run. Edit the excludedDatabases parameter to reintroduce individual databases.",
				"type": "Filter",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.databases",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(contains(pipeline().parameters.excludedDatabases, item()))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachDatabase",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FilterExcludedDatabases",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FilterExcludedDatabases').output.Value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "ExtractDatabase",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_expertm_extract_db",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"databaseName": {
										"value": "@item()",
										"type": "Expression"
									},
									"tables": {
										"value": "@pipeline().parameters.tables",
										"type": "Expression"
									},
									"watermark": {
										"value": "@pipeline().parameters.watermark",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "RunDatabricksBronzeLoad",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEachDatabase",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "04:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 300
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Shared/expertm/nb_expertm_bronze_load"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_test",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"databases": {
